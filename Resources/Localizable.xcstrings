    "A password manager marks its clipboard, and the app skips it without a rule. These lists are for the rest.": {
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un gestore di password marca i suoi appunti e l'app li salta senza una regola. Queste liste servono per il resto."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un gestionnaire de mots de passe marque son presse-papiers, et l'app l'ignore sans règle. Ces listes servent pour le reste."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un gestor de contraseñas marca su portapapeles y la app lo omite sin ninguna regla. Estas listas sirven para el resto."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Um gerenciador de senhas marca a área de transferência dele, e o app a ignora sem nenhuma regra. Estas listas servem para o resto."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein Passwortmanager markiert seine Zwischenablage, und die App überspringt sie ohne Regel. Diese Listen sind für den Rest."
          }
        }
      }
    },
    "A pinned clip stays. A limit never deletes it.": {
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un clip fissato resta. Un limite non lo elimina mai."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un élément épinglé reste. Une limite ne le supprime jamais."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un elemento fijado permanece. Un límite nunca lo elimina."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Um item fixado permanece. Um limite nunca o exclui."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein angehefteter Clip bleibt. Ein Limit löscht ihn nie."
          }
        }
      }
    },
